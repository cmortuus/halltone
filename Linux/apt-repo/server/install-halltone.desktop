[Desktop Entry]
Type=Application
Name=Install / update Halltone
Comment=Install or upgrade the Halltone sender from the LAN apt repo
Exec=sh -c 'curl -fsSL http://apt.localdomain/install-halltone.sh | bash; echo; printf "Press Enter to close. "; read -r _'
Terminal=true
Icon=system-software-install
Categories=AudioVideo;Audio;
