#!/bin/bash
# Builds every new commit on main into an amd64 .deb for the apt repo, so merged fixes reach
# clients without a release tag. Runs as the unprivileged `builder` user from halltone-build.timer;
# halltone-build-import (user repo) then signs it into the repo. Safe to run by hand:
#   sudo runuser -u builder -- /usr/local/bin/halltone-build-main
#
# Version: <last linux-v tag>+git<commits since it>.<sha>, e.g. 0.1.3+git2.1cf2b1b: above that
# release, below the next one, so apt upgrades on every merge and a tag still wins. A commit that
# *is* a tag is skipped: its GitHub release (amd64 + arm64) is imported by halltone-repo-sync.
set -euo pipefail
export LC_ALL=C.UTF-8 PATH="/opt/swift/usr/bin:$PATH"
B=/var/lib/halltone-build
SRC="$B/src"
OUTBOX="$B/outbox"
REMOTE="${HALLTONE_GIT_REMOTE:-https://github.com/cmortuus/halltone.git}"   # override: tests only
BRANCH="${HALLTONE_GIT_BRANCH:-main}"

[ -d "$SRC/.git" ] || git clone --quiet --no-checkout "$REMOTE" "$SRC"
git -C "$SRC" fetch --quiet --prune --tags origin "+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH"
sha=$(git -C "$SRC" rev-parse "origin/$BRANCH")
short=${sha:0:7}
[ -e "$B/state/$sha.done" ] && exit 0

desc=$(git -C "$SRC" describe --tags --match 'linux-v[0-9]*' --long "$sha")   # linux-v0.1.3-2-g1cf2b1b
n=${desc%-g*}; n=${n##*-}
tag=${desc%-*-g*}
if [ "$n" = 0 ]; then
  echo "$short is $tag: its GitHub release is imported by halltone-repo-sync, not built here"
  touch "$B/state/$sha.done"; exit 0
fi
version="${tag#linux-v}+git$n.$short"
[[ "$version" =~ ^[0-9][0-9A-Za-z.+~-]*$ ]] || { echo "bad version '$version' from '$desc'" >&2; exit 1; }

echo "Building $short as $version"
git -C "$SRC" checkout --quiet --force --detach "$sha"
# Keep SwiftPM's build dirs between runs (incremental builds); drop everything else untracked.
git -C "$SRC" clean -ffdxq -e .build
rm -f "$SRC"/Linux/packaging/out/*.deb
nice -n 10 "$SRC/Linux/packaging/build-deb.sh" "$version" amd64
deb="$SRC/Linux/packaging/out/halltone-linux_${version}_amd64.deb"
[ -f "$deb" ] || { echo "build produced no $deb" >&2; exit 1; }
dpkg-deb --field "$deb" Version | grep -qx "$version" || { echo "$deb has the wrong Version field" >&2; exit 1; }
# Into the outbox in one rename, so the importer never sees half a file.
cp "$deb" "$OUTBOX/.incoming.deb" && mv -f "$OUTBOX/.incoming.deb" "$OUTBOX/$(basename "$deb")"
touch "$B/state/$sha.done"
echo "$version: built, waiting for import"
